# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# --- Network ---
# Trading base URL. Testnet for experiments; mainnet is where the rewards are.
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai
# LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai

# Market-data monitoring (run_monitor.py) is read-only/no-auth and always safe, so it
# defaults to mainnet independent of the trading URL above — testnet only has a handful
# of markets (BTC/ETH/SOL), mainnet has the real books incl. RWA/FX pairs.
MARKET_DATA_BASE_URL=https://mainnet.zklighter.elliot.ai

# --- Account / API key (from Lighter's API key generation flow) ---
# See: https://apidocs.lighter.xyz/docs/api-keys
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
# Public half of the API key — not secret, not needed by the SDK (derivable from the
# private key). Kept only for reference / verifying the key registered on your account.
LIGHTER_API_KEY_PUBLIC_KEY=
LIGHTER_API_KEY_PRIVATE_KEY=

# Only needed once, to associate a freshly generated API key with your account.
# Do NOT reuse this for routine bot operation — the bot should only ever need the
# API key private key above, not your wallet's L1 key.
LIGHTER_L1_PRIVATE_KEY=

# --- Bot behavior ---
# true = run against live market data + your real account balances, but orders are only
# simulated ("paper"). Nothing is sent. Use this after any config or code change.
DRY_RUN=true

# Comma-separated symbols to quote. Must be listed in src/sessions.py (trading hours),
# otherwise the bot refuses them. Pick from `python tools/rank_markets.py` each Monday.
MARKETS=ANTHROPIC,OPENAI,CRCL,AMD

# Poll interval for the Phase 0 market-data monitor (run_monitor.py) only
POLL_INTERVAL_SECONDS=15

# --- Sizing / risk ---
# Size of each resting order, per side (exchange minimum is usually $10).
MAX_ORDER_USD=20
# Per-market position cap; the side that would breach it stops quoting.
MAX_POSITION_USD=40
# Account-wide cap on sum of |positions|; above it every market goes reduce-only.
MAX_GROSS_USD=120
# Max loss vs. equity at the start of the UTC day (persisted, survives restarts). Breach =
# cancel everything and halt until the next UTC day.
DAILY_LOSS_LIMIT_USD=10
# Keep at least this fraction of equity free; below it, reduce-only.
MIN_FREE_MARGIN_FRAC=0.3

# --- Quoting ---
# Half-spread floor from mid: max(MIN_EDGE_BPS, EDGE_VOL_MULT x 1h volatility in bps).
# Inside that floor the bot joins the best bid/ask (where liquidity rewards are highest).
MIN_EDGE_BPS=1
EDGE_VOL_MULT=0.1
# Book spread (bps) at which the bot steps one tick inside the spread instead of joining.
IMPROVE_SPREAD_BPS=10
# Leave resting orders alone unless their target moved more than this (saves quota).
REQUOTE_BPS=2
# Shift quotes against inventory by this many bps at MAX_POSITION_USD (0 = off).
SKEW_BPS_AT_CAP=4

# --- Circuit breakers ---
BREAKER_WINDOW_S=30
BREAKER_BPS_MIN=40
BREAKER_VOL_MULT=2
BREAKER_PAUSE_S=300
SYSTEMIC_TRIP_COUNT=3
MAX_BOOK_SPREAD_BPS=150
MAX_MARK_DIVERGENCE_BPS=100
SESSION_LEAD_MINUTES=10
MAX_TX_ERRORS=8
FEED_MAX_SILENCE_S=10

# On a graceful stop, close all positions at market (reduce-only) so only USDC is held.
FLATTEN_ON_STOP=true

# --- Pacing / volume quota ---
# Every order create/modify costs 1 volume quota except one free tx per 15s; you earn 1
# quota per $2 traded. Below QUOTA_RESERVE the bot only uses the free slot.
LOOP_SECONDS=1
ACCOUNT_REFRESH_S=3
QUOTA_RESERVE=300
MAX_PAID_TX_PER_MIN=8
