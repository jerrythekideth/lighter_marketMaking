# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# --- Network ---
# Trading base URL. Start on testnet. Only switch to mainnet in Phase 2, deliberately.
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai
# LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai

# Market-data monitoring (run_monitor.py) is read-only/no-auth and always safe, so it
# defaults to mainnet independent of the trading URL above — testnet only has a handful
# of markets (BTC/ETH/SOL), mainnet has the real books incl. RWA/FX pairs.
MARKET_DATA_BASE_URL=https://mainnet.zklighter.elliot.ai

# --- Account / API key (from Lighter's API key generation flow) ---
# See: https://apidocs.lighter.xyz/docs/api-keys
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_KEY_PRIVATE_KEY=

# Only needed once, to associate a freshly generated API key with your account.
# Do NOT reuse this for routine bot operation — the bot should only ever need the
# API key private key above, not your wallet's L1 key.
LIGHTER_L1_PRIVATE_KEY=

# --- Bot behavior ---
# true = compute and log what the bot would do, never place a real order.
# Keep this true through Phase 0 and all of Phase 1.
DRY_RUN=true

# Comma-separated symbols to quote. Start with 1-2 liquid markets.
MARKETS=XAU,EURUSD

# Poll interval for market-data monitor (seconds)
POLL_INTERVAL_SECONDS=15

# --- Risk limits ---
MAX_POSITION_USD=200
MAX_ORDER_USD=50
DAILY_LOSS_LIMIT_USD=25

# --- Quoting bands (bps from mid) ---
MIN_SPREAD_BPS=5
MAX_SPREAD_BPS=15
ORDER_LEVELS=2
